{
    "name": "ignistack/ignis-ai",
    "description": "AI-powered content generation, SEO optimization, and automatic alt text generation for WordPress with ACF integration",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "authors": [
        {
            "name": "IgniStack Team",
            "email": "team@ignistack.com"
        }
    ],
    "require": {
        "php": ">=8.1",
        "openai-php/client": "^0.10",
        "guzzlehttp/guzzle": "^7.0",
        "php-http/guzzle7-adapter": "^0.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "IgnisAI\\": "includes/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true,
        "allow-plugins": {
            "composer/installers": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
